# provider.tf.example — copy to provider.tf for standalone topology execution.
#
# When running from the REPO ROOT (recommended):
#   terraform apply -var-file="topologies/azure/sample-input-azure.tfvars"
#   The root versions.tf already configures the azurerm provider — nothing needed here.
#
# When running STANDALONE from this directory:
#   cp provider.tf.example provider.tf
#   cd topologies/azure
#   terraform init && terraform apply -var-file="sample-input-azure.tfvars"
#
# provider.tf is gitignored — never commit credentials.

provider "azurerm" {
  subscription_id = var.azure_subscription_id
  tenant_id       = var.azure_tenant_id
  client_id       = var.azure_client_id
  client_secret   = var.azure_client_secret

  use_msi = var.azure_use_msi

  features {}

  resource_provider_registrations = "none"
}
